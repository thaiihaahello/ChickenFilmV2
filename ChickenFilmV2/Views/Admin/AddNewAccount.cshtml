@model ChickenFilmV2.Models.User

@{
    ViewData["Title"] = "Thêm tài khoản mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .page-wrapper {
        max-width: 1500px;
        margin: 60px auto;
        background-color: #fff;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0,0,0,0.05);
        padding: 40px;
        margin-left: 300px;
        margin-top: 100px;
    }

        .page-wrapper h3 {
            font-size: 28px;
            font-weight: bold;
            margin-bottom: 25px;
            color: #333;
        }
</style>

<div class="page-wrapper">
    <h3 class="mb-4">@ViewData["Title"]</h3>

    <form asp-action="AddNewAccount" asp-controller="Admin" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="FullName" class="form-label">Họ tên</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Avatar" class="form-label">Tên file ảnh đại diện</label>
                <input asp-for="Avatar" class="form-control" placeholder="avatar1.png" />
                <span asp-validation-for="Avatar" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Role" class="form-label">Vai trò</label>
                <select asp-for="Role" class="form-select">
                    <option value="Customer">Customer</option>
                    <option value="Admin">Admin</option>
                    <option value="FilmManager">FilmManager</option>
                    <option value="Affiliates">Affiliates</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Gender" class="form-label">Giới tính</label>
                <select asp-for="Gender" class="form-select">
                    <option value="true">Nam</option>
                    <option value="false">Nữ</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Birthday" class="form-label">Ngày sinh</label>
                <input asp-for="Birthday" type="date" class="form-control" />
                <span asp-validation-for="Birthday" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Password" class="form-label">Mật khẩu</label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success">Thêm mới</button>
            <a href="@Url.Action("ManageUsers", "Admin")" class="btn btn-secondary">Quay lại</a>
        </div>
    </form>
</div>

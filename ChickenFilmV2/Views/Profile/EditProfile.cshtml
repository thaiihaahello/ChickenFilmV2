@model ChickenFilmV2.Models.User

@{
    ViewData["Title"] = "Cập nhật thông tin";
}

@section Styles {
    <link rel="stylesheet" href="~/css/EditUser.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
}

<div class="profile-body mt-5 mb-4">
    <h2 class="mb-4">Cập nhật thông tin cá nhân</h2>
    <form asp-action="EditProfile" method="post">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label>Họ và tên</label>
                    <input asp-for="FullName" class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label>Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label>Giới tính</label>
                    <div class="gender">
                        <label><input type="radio" name="Gender" value="true" @(Model.Gender ? "checked" : "") /> Nam</label>
                        <label><input type="radio" name="Gender" value="false" @(!Model.Gender ? "checked" : "") /> Nữ</label>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label>Số điện thoại</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label>Ngày sinh</label>
                    <input asp-for="Birthday" class="form-control" type="date" />
                </div>
                <div class="form-group mb-3">
                    <label>Avatar (URL)</label>
                    <input asp-for="Avatar" class="form-control" />
                </div>
            </div>
        </div>

        <button type="submit"
                class="btn btn-danger mt-3"
                onclick="return confirm('Bạn có chắc muốn cập nhật chứ?');">
            Lưu thay đổi
        </button>
        <a href="@Url.Action("View", "Profile")" class="btn btn-secondary mt-3 ms-2">Quay lại</a>
    </form> 
</div>

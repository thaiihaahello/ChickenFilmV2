@model List<ChickenFilmV2.Models.Auditorium>

<div class="container-fluid pt-2">
    <div class="section-box bg-section-1">
        <div class="section-header">🎬 Thông tin rạp chiếu</div>

        <div class="mb-3">
            <label class="form-label required">Tên rạp chiếu</label>
            <input type="text" class="form-control" value="Galaxy Đà Nẵng" disabled>
        </div>

        <div class="mb-3">
            <label class="form-label required">Địa chỉ</label>
            <input type="text" class="form-control"
                   value="Tầng 3, TTTM Coop Mart, 478 Điện Biên Phủ, Quận Thanh Khê, Đà Nẵng" disabled>
        </div>

        <div>
            <label class="form-label required">Địa chỉ map</label>
            <textarea class="form-control" rows="3" disabled>https://www.google.com/maps/place/...</textarea>
        </div>
    </div>

    <div class="section-box bg-section-2">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="section-header">📽️ Danh sách phòng chiếu</div>
            <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createRoomModal">
                + Tạo
                phòng chiếu
            </button>
        </div>
        @await Html.PartialAsync("CreateAuditorium", new
                 ChickenFilmV2.ViewModelManager.AuditoriumViewModel
   { TheaterId = 1 })
        <table class="table table-bordered align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th>Tên</th>
                    <th>Loại</th>
                    <th>Số lượng Ghế</th>
                    <th>Hàng</th>
                    <th>Cột</th>
                    <th>Ngày</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            @await Html.PartialAsync("EditAuditorium", new ChickenFilmV2.Models.Auditorium { TheaterId = 1 })
            <tbody>
                @foreach (var auditorium in Model)
                {
                    <tr>
                        <td>@auditorium.AuditoriumName</td>
                        <td><span class="badge bg-secondary badge-custom">@auditorium.AuditoriumType</span></td>
                        <td>@auditorium.TotalSeats</td>
                        <td>@auditorium.RowNumber</td>
                        <td>@auditorium.ColumnNumber</td>
                        <td>@auditorium.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="action-icons">
                            <a href="#" class="btn-view-seats" data-id="@auditorium.AuditoriumId" data-bs-toggle="modal" data-bs-target="#seatGridModal">
                                <i class='bx bx-grid' style='color:#800080'></i>
                            </a>
                            <a href="#" class="btn-edit" data-bs-toggle="modal" data-bs-target="#editRoomModal"
                               data-id="@auditorium.AuditoriumId" data-name="@auditorium.AuditoriumName"
                               data-type="@auditorium.AuditoriumType" data-rows="@auditorium.RowNumber"
                               data-cols="@auditorium.ColumnNumber" data-seats="@auditorium.TotalSeats">
                                <i class='bx bxs-pencil' style='color:#0860f8'></i>
                            </a>
                            <form asp-action="DeleteAuditorium" asp-controller="Auditorium"
                                  asp-route-id="@auditorium.AuditoriumId"
                                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa phòng chiếu này không?');"
                                  style="display:inline;">
                                <button type="submit" class="delete-btn" style="border: none; background: none;">
                                    <i class='bx bx-trash' style="color: #ff0d0d;"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Khởi tạo modal bằng Bootstrap 5
            const createRoomModal = new bootstrap.Modal(document.getElementById('createRoomModal'), {
                keyboard: false // Tắt việc đóng modal khi nhấn ESC
            });

            // Hàm mở modal
            window.openModal = function () {
                createRoomModal.show();
            }

            // Hàm đóng modal
            window.closeModal = function () {
                createRoomModal.hide();
            }
        });

        document.addEventListener("DOMContentLoaded", function () {
            const editButtons = document.querySelectorAll(".btn-edit");

            editButtons.forEach(button => {
                button.addEventListener("click", function () {
                    const modal = document.getElementById("editRoomModal");

                    modal.querySelector("input[name*='AuditoriumId']").value = this.dataset.id;
                    modal.querySelector("input[name*='AuditoriumName']").value = this.dataset.name;
                    modal.querySelector("select[name*='AuditoriumType']").value = this.dataset.type;
                    modal.querySelector("input[name*='RowNumber']").value = this.dataset.rows;
                    modal.querySelector("input[name*='ColumnNumber']").value = this.dataset.cols;
                    modal.querySelector("input[name*='TotalSeats']").value = this.dataset.seats;
                });
            });
        });
    </script>

}


@section Styles {
    <link rel="stylesheet" href="~/css/Auditorium/IndexAuditorium.css">
}
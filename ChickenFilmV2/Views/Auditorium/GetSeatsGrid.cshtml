@model Dictionary<string, List<ChickenFilmV2.Models.Seat>>

<div class="seat-grid">
    @foreach (var row in Model)
    {
        <div class="row">
            <span class="row-label">Hàng @row.Key:</span>
            @foreach (var seat in row.Value)
            {
                <div class="seat">
                    <span>@seat.SeatNumber</span>
                </div>
            }
        </div>
    }
</div>

<style>
    .seat-grid {
        display: flex;
        flex-direction: column;
    }

    .row {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

    .row-label {
        font-weight: bold;
        margin-right: 10px;
    }

    .seat {
        width: 30px;
        height: 30px;
        margin-right: 5px;
        background-color: #f0f0f0;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s;
    }

    .seat:hover {
        background-color: #e0e0e0;
    }
</style>

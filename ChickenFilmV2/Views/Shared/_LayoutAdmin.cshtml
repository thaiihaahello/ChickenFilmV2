<!-- Views/Shared/_LayoutAdmin.cshtml -->
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Admin Dashboard</title>
    <link rel="stylesheet" href="~/css/styles.css">
    <!-- Bootstrap, Font Awesome và các link khác -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
</head>
<body>

    <!-- Bao gồm Header Partial View -->
    @await Html.PartialAsync("_HeaderAdmin")

    <div class="admin-container">
        <!-- Bao gồm Sidebar Partial View -->
        @await Html.PartialAsync("_SidebarAdmin")

        <!-- Nội dung chính của trang -->
        <main class="admin-content">
            @RenderBody() <!-- Nội dung trang cụ thể -->
        </main>
    </div>

</body>
</html>

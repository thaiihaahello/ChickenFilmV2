<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="icon" href="images/logosixchicken.png">
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome (Icon) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="vendor/jqvmap/css/jqvmap.min.css">
    <link rel="stylesheet" href="vendor/chartist/css/chartist.min.css">
    <!-- Summernote -->
    <link href="vendor/summernote/summernote.css" rel="stylesheet">
    <link rel="stylesheet" href="vendor/bootstrap-select/dist/css/bootstrap-select.min.css">
    <style>
        /* Custom CSS for the header */
        .admin-header {
            background-color: #5a5454;
            color: white;
            padding: 10px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .admin-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000; /* Đảm bảo header luôn nổi bật */
            background-color: #5a5454;
            color: white;
            padding: 10px 20px;
        }

            .admin-header .nav-icons a {
                color: white;
                margin-right: 15px;
            }

            .admin-header .admin-info {
                display: flex;
                align-items: center;
            }

                .admin-header .admin-info img {
                    width: 40px;
                    height: 40px;
                    border-radius: 50%;
                    margin-right: 10px;
                }

                .admin-header .admin-info a {
                    color: white;
                    text-decoration: none;
                }

        .status-online {
            color: rgb(100, 248, 100);
            cursor: pointer;
        }

        .status-offline {
            color: rgb(252, 14, 14);
        }

        .admin-header {
            background-color: #5a5454;
            color: white;
            padding: 10px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-left: 220px;
        }

            .admin-header .nav-icons a {
                color: white;
                margin-right: 15px;
            }

            .admin-header .admin-info {
                display: flex;
                align-items: center;
            }

                .admin-header .admin-info img {
                    width: 40px;
                    height: 40px;
                    border-radius: 50%;
                    margin-right: 10px;
                }

                .admin-header .admin-info a {
                    color: white;
                    text-decoration: none;
                }
           

    </style>
</head>
<body class="bg-light">
    <!-- Admin Header -->
    <div class="admin-header">
        <div class="nav-icons">
            <a href="#"><i class="fa-regular fa-envelope"></i></a>
            <a href="#"><i class="fa-regular fa-bell"></i></a>
            <a href="#"> <i class="fa fa-bars"></i></a>
        </div>
        <div class="admin-info">
            <img src="~/images/AvatarAdmin.jpg" alt="Admin Avatar">
            <div>
                <strong>@User.Identity.Name</strong>
                <br>
                <span id="admin-status" class="status-online">● Online</span>
                <br>
                <a class="text-white text-decoration-none" asp-controller="Account" asp-action="Logout">Đăng xuất <i class="fa-solid fa-right-from-bracket"></i></a>
              
            </div>
        </div>
    </div>

   
    <script>
        let statusElement = document.getElementById("admin-status");
        let inactivityTimer;

        function setStatus(isOnline) {
            if (isOnline) {
                statusElement.innerText = "● Online";
                statusElement.style.color = "rgb(100, 248, 100)";
            } else {
                statusElement.innerText = "● Offline";
                statusElement.style.color = "rgb(252, 14, 14)";
            }
        }

        function resetInactivityTimer() {
            clearTimeout(inactivityTimer);
            setStatus(true); // Đặt lại trạng thái Online khi có hoạt động
            inactivityTimer = setTimeout(() => {
                setStatus(false); // Chuyển thành Offline nếu không hoạt động trong 5 giây
            }, 5000);
        }

        // Sự kiện theo dõi hoạt động của chuột
        document.addEventListener("mousemove", resetInactivityTimer);
        document.addEventListener("keydown", resetInactivityTimer); // Bắt sự kiện bàn phím

        // Khởi tạo bộ đếm thời gian ngay khi tải trang
        window.onload = resetInactivityTimer;
    </script>
    <script src="vendor/global/global.min.js"></script>
    <script src="vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
    <script src="js/custom.min.js"></script>
    <script src="js/dlabnav-init.js"></script>

    <!-- Chart sparkline plugin files -->
    <script src="vendor/jquery-sparkline/jquery.sparkline.min.js"></script>
    <script src="js/plugins-init/sparkline-init.js"></script>

    <!-- Chart Morris plugin files -->
    <script src="vendor/raphael/raphael.min.js"></script>
    <script src="vendor/morris/morris.min.js"></script>

    <!-- Init file -->
    <script src="js/plugins-init/widgets-script-init.js"></script>

    <!-- Demo scripts -->
    <script src="js/dashboard/dashboard.js"></script>

    <!-- Summernote -->
    <script src="vendor/summernote/js/summernote.min.js"></script>
    <!-- Summernote init -->
    <script src="js/plugins-init/summernote-init.js"></script>

    <!-- Svganimation scripts -->
    <script src="vendor/svganimation/vivus.min.js"></script>
    <script src="vendor/svganimation/svg.animation.js"></script>
    <script src="js/styleSwitcher.js"></script>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
@section Scripts {
    <script src="~/js/AdminStatus.js"></script> <!-- Ensure you have this JavaScript file to manage the admin status -->
}
</html>

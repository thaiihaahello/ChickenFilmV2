@model ChickenFilmV2.ViewModelManager.FilterShowtimeViewModel

<div class="section-box bg-section-2">
    <form method="get" asp-action="IndexShowtime" asp-controller="Showtimes" class="search-panel card mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-md-5 d-flex align-items-center">
                <label class="form-label mb-0 me-2" style="min-width: 100px;">Phòng chiếu:</label>
                <select class="form-select" id="auditorium-select" asp-for="SearchAuditoriumName">
                    <option value="">--Tất cả--</option>
                    @foreach (var name in Model.AuditoriumName)
                        {
                            if (name == Model.SearchAuditoriumName)
                            {
                                <option value="@name" selected>@name</option>
                            }
                            else
                            {
                                <option value="@name">@name</option>
                            }
                        }
                </select>
            </div>
            <div class="col-md-5 d-flex align-items-center">
                <label class="form-label mb-0 me-2" style="min-width: 100px;">Ngày chiếu:</label>
                <input type="date" class="form-control" asp-for="SearchShowDate" value="@Model.SearchShowDate.ToString()">
            </div>
            <div class="col-md-2 d-flex justify-content-end">
                <button class="btn custom-btn-search w-95">Tìm kiếm</button>
            </div>
        </div>
        </form>
        @await Html.PartialAsync("CreateShowtime", Model.createModel)
     @if (Model.Showtime != null && Model.Showtime.Any())
    {
        <div class="card">
  
            <table class="table table-bordered align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>Phim chiếu</th>
                        <th>Phòng chiếu</th>
                        <th>Hình thức chiếu</th>
                        <th>Hình thức dịch</th>
                        <th>Ngày chiếu</th>
                        <th>Suất chiếu</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var showtime in Model.Showtime)
                    {
                        <tr>
                            <td class="text-danger">@showtime.MovieTitle</td>
                            <td>@showtime.AuditoriumName</td>
                            <td>
                                <span class="badge @GetFormatBadgeClass(showtime.Format)">@showtime.Format</span>
                            </td>
                            <td>
                                <span class="badge @GetLanguageBadgeClass(showtime.Language)">@showtime.Language</span>
                            </td>
                            <td>@showtime.ShowDate</td>
                            <td>@showtime.Showtimes</td>
                            <td class="status status-done">@showtime.Status</td>
                            <td class="action-icons">
                                <a href="#" title="Chỉnh sửa"><i class='bx bxs-pencil' style='color:#0860f8'></i></a>
                                <a href="#" title="Xoá" onclick="return confirm('Bạn chắc chắn muốn xoá?')">
                                    <i class='bx bx-trash-alt' style='color:#ff0d0d'></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex align-items-center gap-2 mb-3 mt-3">
            <button class="btn custom-btn-create btn-sm" data-bs-toggle="modal" data-bs-target="#createShowtimeModal">
                + Tạo suất chiếu
            </button>
        </div>
    }
    else if (Model.Showtime == null)
    {
        <p class="text-center">Không có kết quả phù hợp</p>
    }
</div>

@functions {
    string GetFormatBadgeClass(string format)
    {
        return format switch
        {
            "2D" => "bg-primary",
            "3D" => "bg-success",
            "IMAX" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }

    string GetLanguageBadgeClass(string language)
    {
        return language switch
        {
            "sub" => "bg-info text-dark",
            "dubbed" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}

@section Styles{
        <link rel="stylesheet" href="~/css/Showtime.css">
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Khởi tạo modal
        const createScheduleModal = new bootstrap.Modal(document.getElementById('createShowtimeModal'), {
            keyboard: false
        });
        // Hàm mở modal
        window.openModal = function () {
            createScheduleModal.show();
        }

        // Hàm đóng modal
        window.closeModal = function () {
            createScheduleModal.hide();
        }
    });
</script>